APP_NAME="ECIMS"
APP_VERSION=1.0.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Laragon: http://srs.test (document root: cohas/public — see auto.srs.test.conf)
# Other local: http://localhost or http://192.168.x.x
# Cloudflare Tunnel: your public URL + TRUSTED_PROXIES=* and SESSION_SECURE_COOKIE=true
APP_URL=http://srs.test

# Behind Cloudflare Tunnel set TRUSTED_PROXIES=* and SESSION_SECURE_COOKIE=true
TRUSTED_PROXIES=
SESSION_SECURE_COOKIE=false
# Auto logout after inactivity (minutes); set 0 to disable
IDLE_LOGOUT_MINUTES=20
# Prompt countdown before forced logout (seconds)
IDLE_PROMPT_SECONDS=60

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cohas
DB_USERNAME=root
DB_PASSWORD=
# Only needed if `mysqldump` isn't on the server's PATH (e.g. local Windows/Laragon
# installs). Set to the directory containing mysqldump(.exe), not the exe itself.
# Example (Laragon): C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin
MYSQLDUMP_BINARY_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@musomacohas.ac.tz"
MAIL_FROM_NAME="${APP_NAME}"

# Mailgun (set MAIL_MAILER=mailgun to switch on real delivery). Get these from
# https://app.mailgun.com — Sending → Domain settings. Use api.eu.mailgun.net
# for MAILGUN_ENDPOINT if your Mailgun account/domain is in the EU region.
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# Where nightly DB-backup success/failure notifications are sent (config/backup.php).
# Set to a real admin mailbox; requires a working MAIL_MAILER to actually be delivered.
BACKUP_NOTIFICATION_EMAIL=

VITE_APP_NAME="${APP_NAME}"

# Twilio SMS (results & bulk messages)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_DEFAULT_COUNTRY_CODE=255

# Result release SMS (requires TWILIO_ENABLED=true)
RESULT_SMS_ON_FINAL_IMPORT=false
RESULT_SMS_ON_CA_IMPORT=false
RESULT_SMS_NOTIFY_GUARDIAN=true
RESULT_SMS_NOTIFY_STUDENT=true
RESULT_SMS_DEDUPE=true
RESULT_SMS_PORTAL_PATH=/my-module-results
RESULT_SMS_LOCALE=en

# External links (Integrations page — no API; GEPG added when authorized)
MOODLE_URL=
LIBRARY_SYSTEM_URL=

# SMTP for password reset & outbound email (use log driver only in dev)
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
